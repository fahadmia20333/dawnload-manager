{
  "name": "meldrix-download-manager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "predev": "npm run build:extensions",
    "build:desktop": "npm run build",
    "build:electron": "npm run build:desktop",
    "build:chrome": "node extension/build.cjs chrome",
    "build:edge": "node extension/build.cjs edge",
    "build:extensions": "node extension/build.cjs all",
    "build:installer": "npm run build-native-host && npm run build:desktop && npm run build:extensions && electron-builder --win nsis",
    "build:all": "npm run build-native-host && npm run build:desktop && npm run build:extensions && electron-builder --win nsis portable",
    "test": "node --test electron/download-utils.test.cjs electron/download-integration.test.cjs extension/build.test.cjs",
    "start": "electron .",
    "build-native-host": "node native-host/build.cjs",
    "pre-dist": "npm run build-native-host",
    "dist": "npm run build-native-host && npm run build:desktop && npm run build:extensions && electron-builder --win nsis portable",
    "dist:installer": "npm run build:installer",
    "dist:portable": "npm run build-native-host && npm run build:desktop && npm run build:extensions && electron-builder --win portable",
    "native-host": "node native-host/install.cjs",
    "native-host:uninstall": "node native-host/uninstall.cjs"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^5.3.2",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.meldrix.downloadmanager",
    "productName": "Meldrix Download Manager",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/extensions/**/*",
      "electron/**/*",
      "native-host/extension-origins.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/extensions/chrome/unpacked",
        "to": "extensions/chrome"
      },
      {
        "from": "dist/extensions/edge/unpacked",
        "to": "extensions/edge"
      },
      {
        "from": "native-host/MeldrixNativeHost.exe",
        "to": "native-host/MeldrixNativeHost.exe"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meldrix Download Manager",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "MeldrixDownloadManager-Portable.exe"
    },
    "artifactName": "MeldrixDownloadManager-Setup.${ext}"
  }
}
