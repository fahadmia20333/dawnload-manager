{
  "manifest_version": 3,
  "name": "Meldrix Download Manager",
  "version": "0.2.0",
  "description": "Send authorized browser downloads and direct HTML5 media to Meldrix.",
  "key": "",
  "permissions": ["alarms", "contextMenus", "downloads", "nativeMessaging", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Meldrix Download Manager", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "options_page": "options.html"
}
