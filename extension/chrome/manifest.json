{
  "manifest_version": 3,
  "name": "Meldrix Download Manager",
  "version": "0.2.0",
  "description": "Send supported browser downloads and direct media to Meldrix on Windows.",
  "key": "",
  "permissions": ["alarms", "contextMenus", "downloads", "nativeMessaging", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Meldrix Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "options_page": "options.html"
}
